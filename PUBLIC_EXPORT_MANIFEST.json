    "plugin/utility-search/api/server.js",
    "plugin/utility-search/lib/catalog.js",
    "plugin/utility-search/lib/public-catalog.js",
    "plugin/utility-search/package.json",
    "plugin/utility-search/schemas/utility-catalog.schema.json",
    "plugin/utility-search/server.js",
    "plugin/utility-search/tests/catalog.test.js",
    "plugin/utility-search/tests/fixtures/catalog.json",
    "plugin/utility-search/vercel.json",
    "runtime/bridge-trigger.txt",
