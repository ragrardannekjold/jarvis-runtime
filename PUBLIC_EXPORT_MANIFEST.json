  "bridge_secret_required": "COMMAND_CENTER_TOKEN",
  "command_center_runtime_schedule_enabled": true,
  "daily_report_schedule": {
    "enabled": true,
    "timezone": "Europe/Kyiv",
    "report_label_local_time": "20:00",
    "primary_local_time": "20:07",
    "fallback_local_time": "20:27",
    "one_final_report_per_local_date": true,
    "private_readback_required": true,
    "durable_result_ledger_used": true,
    "commit_triggered_verification_available": true,
    "verification_marker": "[main-daily-report:verification]",
    "mode_selector_regression_tested": true,
    "readback_retry": {
      "attempts": 7,
      "base_delay_seconds": 0.5,
      "exact_content_required": true,
      "transient_404_recovery_tested": true,
      "stale_content_recovery_tested": true,
      "fail_closed_on_non_convergence": true
    }
  },
  "public_output_policy": {
    "private_report_content_logged": false,
    "private_report_artifact_uploaded": false,
    "automatic_chat_push_claimed": false,
    "automatic_google_drive_delivery_claimed": false
  },
  "last_verified_before_candidate": {
