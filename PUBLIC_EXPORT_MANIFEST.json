{
  "schema_version": 3,
  "public_repository_name": "jarvis-runtime",
  "purpose": "Sanitized public execution shell for the private canonical main control plane.",
  "canonical_private_source": "ragrardannekjold/jarvis-command-center@main",
  "runtime_state_branch_private": "jarvis-runtime-state",
  "deployment_state": "CANDIDATE_UNTIL_MAIN_CANARY",
  "runtime_contract": {
    "complete_public_workflow_inventory_required": true,
    "unknown_workflow_fails_closed": true,
    "direct_push_to_private_main_forbidden": true,
    "legacy_repository_checkout_forbidden": true,
    "secret_bearing_pull_request_forbidden": true,
    "private_output_in_public_artifacts_forbidden": true,
    "single_daily_report_private_readback_required": true
  },
  "active_workflows": {
    "command-center-runtime.yml": "canonical runtime heartbeat, queue, safe executors and recovery snapshot",
    "kyiv-fast-watch.yml": "safety-critical early-warning fast path",
    "main-daily-report.yml": "one evidence-first private main report per Kyiv local date",
    "relay-a7.yml": "bounded A7 execution to private state",
    "runtime-self-test.yml": "secret-free public runtime regression tests",
    "utility-search-self-test.yml": "SHADOW-only utility-search validation"
  },
  "retired_and_absent": [
    ".github/workflows/legacy-liski-bridge-smoke.yml",
    ".github/workflows/repair-checkpoint-parser.yml",
    ".github/workflows/scheduler-liveness-probe.yml",
    "runtime/legacy-liski-trigger.txt",
    "runtime/repair-checkpoint-parser-trigger.txt"
  ],
  "allowlist": [
